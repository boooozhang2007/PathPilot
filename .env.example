# PathPilot server environment template
PORT=3000
JWT_SECRET=
# 分享链接对外访问地址（Web 前端），用于生成只读规划分享 URL；默认本地 Web 开发地址
PUBLIC_BASE_URL=http://localhost:3001
# Web development runs on port 3001. Set an explicit allowlist in production.
# CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://your-web-domain.example
ADMIN_KEY=
AGENT_PROVIDER=zhipu
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_API_KEY=
SEARCH_TIMEOUT_MS=15000
AGENT_TIMEOUT_MS=180000
AGENT_CHAT_TIMEOUT_MS=300000
AGENT_MAX_TOOL_CALLS=40
TAVILY_API_KEY=
