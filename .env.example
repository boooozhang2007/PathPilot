# ===== PathPilot 服务端配置（复制为 .env 使用）=====
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# Pi Agent LLM（可选：不配置则自动降级规则引擎，功能完整可演示）
# provider 可选 zhipu（智谱 GLM）| deepseek | custom（任意 OpenAI 兼容端点）
AGENT_PROVIDER=zhipu
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_API_KEY=
AGENT_MODEL=glm-4.6

# 搜索
SEARCH_TIMEOUT_MS=15000
# Agent 运行限制
AGENT_TIMEOUT_MS=180000
AGENT_MAX_TOOL_CALLS=40
TAVILY_API_KEY=
# 可选：Tavily 搜索 API（配置后启用实时联网岗位搜索，https://tavily.com）

# 猎聘官方 MCP（岗位搜索通道；https://www.liepin.com/mcp/auth 获取，90 天有效）
LIEPIN_USER_TOKEN=

# 管理页密钥（Web /admin）
ADMIN_KEY=
